# User service: systemctl --user {start,stop,status} beaglewing-clipboard
# Unlike the router, this needs no portal consent, so it is safe to
# enable at login.

[Unit]
Description=Beaglewing clipboard agent (Ubuntu side)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/beaglewing-router clipboard
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
